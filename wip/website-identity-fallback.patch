+  const clean = (value: string | undefined | null, max: number) => {
+    const text = value ? decodeEntities(value.replace(/<[^>]*>/g, " ")).replace(/[\u0000-\u001f\u007f]/g, " ").replace(/\s+/g, " ").trim() : "";
