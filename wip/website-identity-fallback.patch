@@ -0,0 +1,170 @@
+import { randomUUID } from "node:crypto";
+import { BusinessDiscoverySchema, CollectedSourceSchema, type BusinessContext, type BusinessDiscovery, type CollectedSource, type ModelUsage } from "./contracts";
+import { brandDomainMatchesName, discoveryBrandDomain, discoveryHistoricalSourceHint, discoveryNameMatches, DISCOVERY_GENERIC_NAME_WORDS } from "./discover";
+import { SourceReadError, validateSourceUrl, type OfficialPage } from "./source-reader";
+
+/**
+ * Bounded identity fallback for an owner-supplied official website.
+ *
+ * Runs only when Meta-native discovery did not establish a business name. The supplied page is read
+ * once through the SSRF-safe official-site reader (no credentials, robots respected, same-origin
+ * redirects only). The brand name comes deterministically from the page's own first-party metadata
+ * and must be consistent with its domain or visible text. Locality, offerings and story are never
+ * derived here, the campaign goal is never used, and the branch stays unresolved.
+ */
+
+export const SUPPLIED_WEBSITE_IDENTITY_SUMMARY = "Identified from the supplied website's own title and site name; offerings, story and location are researched from the page itself, not assumed here.";
+export const SUPPLIED_WEBSITE_IDENTITY_WARNING = "Business identity was taken from the supplied website's own title and site name because Meta search returned no usable sources; the branch is not confirmed.";
+
+type DiscoveryResult = { discovery: BusinessDiscovery; sources: CollectedSource[]; usage: ModelUsage };
+export type SuppliedWebsiteReader = (url: string) => Promise<OfficialPage>;
+export type SuppliedWebsiteOutcome = "not_eligible" | "established" | "not_established" | "unreadable";
+
+const MAX_NAME_LENGTH = 80;
+const TITLE_SEPARATOR = /\s*[|·•»]\s*|\s+[–—-]\s+|\s*:\s+/;
+const GENERIC_NAMES = new Set([
+  "home", "homepage", "home page", "welcome", "shop", "store", "online store", "shop online", "menu", "our menu", "index", "main",
+  "official website", "official site", "website", "web site", "site", "untitled", "coming soon", "under construction", "maintenance",
+  "page not found", "not found", "404", "error", "about", "about us", "contact", "contact us", "products", "all products", "collections",
+  "my site", "my blog", "blog", "default", "just another wordpress site", "order online", "cart", "checkout", "login", "log in", "sign in",
+]);
+// Hosting, error, parking and bot-check interstitials can return HTTP 200 and repeat their own title.
+const INTERSTITIAL_NAME = /^(?:index of\b|it works\b|welcome to (?:nginx|apache|iis|openresty|caddy)\b)|\b(?:account (?:has been )?suspended|suspended (?:account|site|website|page|domain)|(?:site|website|domain|hosting|account) (?:is )?(?:suspended|expired|unavailable|disabled|inactive|parked)|maintenance|under construction|coming soon|attention required|just a moment|access denied|forbidden|bad gateway|service (?:temporarily )?unavailable|gateway time-?out|internal server error|server error|page not found|not found|(?:domain|website|site) (?:is )?for sale|buy this domain|parked (?:domain|free)|default (?:web )?(?:site |server )?page|test page|bandwidth limit|resource limit|too many requests|security check|captcha|ddos protection|checking your browser|cloudflare|error \d{3}|\d{3} error)\b/;
+// Category and page words that never identify a brand on their own.
+const GENERIC_WORDS = new Set([...DISCOVERY_GENERIC_NAME_WORDS, "home", "welcome", "official", "website", "site", "online", "menu", "order", "orders",
+  "cakes", "cake", "desserts", "dessert", "pastries", "pastry", "bread", "breads", "cookies", "baking", "baked", "fresh", "freshly", "fine",
+  "products", "services", "gallery", "catalog", "catalogue", "delivery", "booking", "appointments", "pricing", "news", "events", "offers", "gifts", "hampers"]);
+
+function normalise(value: string): string {
+  return value.normalize("NFKC").replace(/[’‘`]/g, "'").replace(/[“”]/g, '"').replace(/\s+/g, " ").trim().toLowerCase();
+}
+
+function cleanCandidate(raw: string | null | undefined): string | null {
+  if (!raw) return null;
+  const value = raw.normalize("NFKC").replace(/[\u0000-\u001f\u007f]/g, " ").replace(/[®™©]/g, " ").replace(/\s+/g, " ").trim()
+    .replace(/^welcome\s+to\s+/i, "")
+    .replace(/\s*(?:[-–—|:]\s*)?official\s+(?:website|site|store|online\s+store)$/i, "")
+    .replace(/^["'“”‘’\s]+|["'“”‘’\s.,;!]+$/g, "").trim();
+  return value || null;
+}
+
+/** Brand-like names only: not empty, generic, a bare domain, too short or too long. */
+export function acceptableSiteBrandName(name: string): boolean {
+  const lower = normalise(name);
+  if (!lower || name.length > MAX_NAME_LENGTH || GENERIC_NAMES.has(lower) || INTERSTITIAL_NAME.test(lower)) return false;
+  if ((lower.match(/\p{L}/gu) ?? []).length < 3) return false;
+  if (/^(?:https?:\/\/)?(?:www\.)?[a-z0-9-]+(?:\.[a-z0-9-]+)+\/?$/i.test(lower)) return false;
+  const words = lower.replace(/'s\b/g, "").match(/[\p{L}\p{N}]+/gu) ?? [];
+  return words.some((word) => word.length >= 3 && !GENERIC_WORDS.has(word));
+}
+
+function occurrences(name: string, text: string): number {
+  const words = normalise(name).match(/[\p{L}\p{N}']+|&/gu);
+  if (!words?.length) return 0;
+  const escaped = words.map((word) => word.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")).join("[\\s\\-]+");
+  return [...normalise(text).matchAll(new RegExp(`(?<![\\p{L}\\p{N}])${escaped}(?![\\p{L}\\p{N}])`, "gu"))].length;
+}
+
+/** The name must match the brand domain or recur in the page's own visible text. The title/head is not visible text. */
+export function siteBrandNameSupported(name: string, pageUrl: string, visibleText: string): boolean {
+  const domain = discoveryBrandDomain(pageUrl);
+  if (!domain || !acceptableSiteBrandName(name)) return false;
+  return brandDomainMatchesName(name, domain.label) || occurrences(name, visibleText) >= 2;
+}
+
+function titleCandidate(title: string): string | null {
+  const segments = title.split(TITLE_SEPARATOR).map((segment) => cleanCandidate(segment)).filter((segment): segment is string => Boolean(segment));
+  // "Home | Brand" is a common CMS pattern: skip one leading generic page label, never more.
+  if (segments.length > 1 && GENERIC_NAMES.has(normalise(segments[0]))) return segments[1];
+  return segments[0] ?? null;
+}
+
+/**
+ * Deterministic: og:site_name, else the title prefix, else the first <h1>; the first acceptable, consistent candidate wins.
+ * When another first-party candidate spells the same name with different capitals (og:site_name "labonel Fine baking",
+ * title "Labonel Fine Baking | ..."), the title's, then the heading's, spelling is used.
+ */
+export function deriveSiteBrandName(page: Pick<OfficialPage, "url" | "title" | "text" | "identity">): string | null {
+  const title = titleCandidate(page.title);
+  const heading = cleanCandidate(page.identity?.heading);
+  const candidates = [cleanCandidate(page.identity?.siteName), title, heading];
+  for (const candidate of candidates) {
+    if (!candidate || !siteBrandNameSupported(candidate, page.url, page.text)) continue;
+    return [title, heading].find((spelling) => spelling && spelling !== candidate && normalise(spelling) === normalise(candidate)) ?? candidate;
+  }
+  return null;
+}
+
+/** The supplied link qualifies only when it is a readable brand domain, not Maps/Google, social, listing, marketplace or link-in-bio. */
+export function suppliedWebsiteForIdentity(business: BusinessContext, discovery: BusinessDiscovery): string | null {
+  if (discovery.status === "matched" || discovery.name || !business.website) return null;
+  let url: URL;
+  try { url = validateSourceUrl(business.website); } catch { return null; }
+  if (!discoveryBrandDomain(url.href)) return null;
+  try { if (new URL(discovery.inputUrl).origin !== url.origin) return null; } catch { return null; }
+  return url.href;
+}
+
+function sameOrigin(first: string | null | undefined, second: string | null | undefined): boolean {
+  try { return Boolean(first && second) && new URL(first!).origin === new URL(second!).origin; } catch { return false; }
+}
+
+/** Revalidates a stored supplied-website identity source without reading anything. */
+export function suppliedWebsiteIdentitySupported(discovery: BusinessDiscovery, source: CollectedSource, businessName: string): boolean {
+  if (source.acquisition !== "direct_website" || source.kind !== "official_website" || !source.url || !discovery.name) return false;
+  if (!sameOrigin(source.url, discovery.inputUrl) || !discovery.officialWebsite || discovery.officialWebsite !== `${new URL(source.url).origin}/`) return false;
+  try { validateSourceUrl(source.url); } catch { return false; }
+  if (businessName.trim() && !discoveryNameMatches(businessName, discovery.name)) return false;
+  return siteBrandNameSupported(discovery.name, source.url, source.text);
+}
+
+/**
+ * Applies the fallback to a completed (or saved) discovery result. Never throws and never calls Meta;
+ * an ineligible link performs no read, and any read or consistency failure leaves identity unconfirmed.
+ */
+export async function establishIdentityFromSuppliedWebsite(
+  business: BusinessContext,
+  result: DiscoveryResult,
+  dependencies: { readPage: SuppliedWebsiteReader; id?: () => string; beforeRead?: () => Promise<void> | void },
+): Promise<DiscoveryResult & { outcome: SuppliedWebsiteOutcome }> {
+  // Only when Meta returned no sources at all: cited Meta material (possibly about another branch or business) is never upgraded here.
+  const supplied = result.sources.length === 0 ? suppliedWebsiteForIdentity(business, result.discovery) : null;
+  if (!supplied) return { ...result, outcome: "not_eligible" };
+  const unchanged = (outcome: SuppliedWebsiteOutcome, warning: string) => ({
+    ...result, outcome, discovery: { ...result.discovery, warnings: [...new Set([...result.discovery.warnings, warning])] },
+  });
+  let page: OfficialPage;
+  try {
+    await dependencies.beforeRead?.();
+    page = await dependencies.readPage(supplied);
+    validateSourceUrl(page.url);
+    if (!sameOrigin(page.url, supplied)) throw new SourceReadError("CROSS_ORIGIN_REDIRECT", "The supplied website redirected to another origin.");
+  } catch (error) {
+    const code = error instanceof SourceReadError ? error.code : "READ_FAILED";
+    return unchanged("unreadable", `The supplied website could not be read directly (${code}); the business identity remains unconfirmed.`);
+  }
+  const name = deriveSiteBrandName(page);
+  if (!name || business.name.trim() && !discoveryNameMatches(business.name, name)) {
+    return unchanged("not_established", "The supplied website's own title, site name and heading did not consistently identify the business; the identity remains unconfirmed.");
+  }
+  const officialWebsite = `${new URL(page.url).origin}/`;
+  const source = CollectedSourceSchema.parse({
+    id: (dependencies.id ?? randomUUID)(), kind: "official_website", title: (page.title || name).slice(0, 180), url: page.url,
+    text: page.text.slice(0, 12_000), retrievedAt: page.retrievedAt, acquisition: "direct_website",
+    context: { scope: "brand", location: null, locationEvidence: null, publishedAt: null, validFrom: null, validThrough: null,
+      temporalStatus: discoveryHistoricalSourceHint(page.url, page.text, page.retrievedAt) ? "historical" : "unknown", dateEvidence: null },
+  });
+  const previous = result.discovery;
+  const branch = previous.branch ?? { status: "unresolved" as const, label: null, locality: null, address: null, sourceIds: [], rationale: "A brand match does not establish which location the supplied link represents. No source-supported exact location was established." };
+  const stale = new Set(["Business identity could not be completely resolved from attributed output."]);
+  const links = previous.links.some((link) => link.url === page.url) ? previous.links.map((link) => link.url === page.url ? { ...link, relationship: "business" as const } : link)
+    : [{ url: page.url, title: source.title, relationship: "business" as const }, ...previous.links].slice(0, 12);
+  const discovery = BusinessDiscoverySchema.parse({
+    // Unsourced model locality, vertical and summary are never carried into the upgraded identity; the page's own
+    // opening text (often template placeholder copy) is not used as a summary either.
+    ...previous, status: "matched", name, officialWebsite, locality: null, vertical: null, summary: SUPPLIED_WEBSITE_IDENTITY_SUMMARY,
+    sourceIds: [source.id], links, branch: branch.status === "unresolved" ? branch : { ...branch, status: "unresolved" },
+    warnings: [...new Set([SUPPLIED_WEBSITE_IDENTITY_WARNING, ...previous.warnings.filter((warning) => !stale.has(warning))])],
+  });
+  return { discovery, sources: [...result.sources, source], usage: result.usage, outcome: "established" };
+}
