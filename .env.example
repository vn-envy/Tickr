# Keep keys server-side. In Codex use environment settings for META_API_KEY.
META_API_KEY=
# Optional overrides; research/strategy default to verified muse-spark-1.3.
# Contributor variants are not enabled for business data.
META_REASONING_MODEL=
META_STRATEGY_MODEL=
META_IMAGE_MODEL=
META_SEGMENTATION_MODEL=
# Optional critic model: muse-spark-1.3 (default) or muse-wonder-1.0.
META_CRITIC_MODEL=

# Optional owner Meta connection (Autopilot harvests the owner's own Instagram/Facebook media).
# All four are required to enable it; values stay server-side and are never logged.
META_APP_ID=
META_APP_SECRET=
# Must exactly equal the callback registered in the Meta app, e.g.
# http://localhost:3000/api/connections/meta/callback
META_OAUTH_REDIRECT_URI=
# 32 random bytes, base64 (e.g. `openssl rand -base64 32`). Encrypts owner tokens at rest
# and keys the media-library manifest and attestation records.
TICKR_SECRET_KEY=
# Optional: Facebook Login for Business configuration id (replaces scope list); Graph version.
META_LOGIN_CONFIG_ID=
META_GRAPH_VERSION=
# Relative to the repository root. Local SQLite; never a remote DB service.
DATABASE_URL=file:./.data/tickr.db
REMOTION_BROWSER_EXECUTABLE=/usr/bin/chromium
NEXT_TELEMETRY_DISABLED=1
# Set before Node starts; npm dev/start/worker/meta:check enable this.
NODE_USE_ENV_PROXY=1
# Opt-in ONLY behind an egress proxy that refuses IP-literal CONNECT (e.g. some cloud dev sandboxes):
# official-site reads then CONNECT by hostname after all local DNS/public-IP checks. Leave unset
# for direct deployments (Modal), which keep strict IP pinning. See docs/ARCHITECTURE.md.
TICKR_PROXY_CONNECT_BY_HOSTNAME=
