# Keep keys server-side. In Codex use environment settings for META_API_KEY.
META_API_KEY=
# Optional overrides; research/strategy default to verified muse-spark-1.3.
# Contributor variants are not enabled for business data.
META_REASONING_MODEL=
META_STRATEGY_MODEL=
META_IMAGE_MODEL=
META_SEGMENTATION_MODEL=
# Relative to the repository root. Local SQLite; never a remote DB service.
DATABASE_URL=file:./.data/tickr.db
REMOTION_BROWSER_EXECUTABLE=/usr/bin/chromium
NEXT_TELEMETRY_DISABLED=1
# Set before Node starts; npm dev/start/worker/meta:check enable this.
NODE_USE_ENV_PROXY=1
